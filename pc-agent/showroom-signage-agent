#!/usr/bin/python3
"""Showroom signage agent: plays a Home Assistant signage playlist with mpv.

Home Assistant (the showroom_signage integration) publishes this screen's
playlist to MQTT, retained, at showroom_signage/<SCREEN_ID>/playlist. This
agent downloads the files it doesn't have into MEDIA_DIR (links signed by
Home Assistant, so no login here), deletes the ones that left the playlist,
writes playlist.m3u and settings.env for the slideshow, and loads the new
list into the running mpv without restarting it.

It reports what mpv shows at .../status, online/offline at .../availability,
and takes play, pause, next and previous at .../command. It only connects
out (MQTT, HTTP to Home Assistant); it doesn't listen on the network.

Settings: /etc/showroom/signage.conf (KEY=value). Runs as the display user
(showroom-signage-agent.service), next to showroom-slideshow.service.
"""

import hashlib
import json
import logging
import os
import socket
import threading
import time
import urllib.request
from pathlib import Path

import paho.mqtt.client as mqtt

CONF_FILE = "/etc/showroom/signage.conf"
log = logging.getLogger("signage")


def read_conf(path=CONF_FILE):
    conf = {}
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            conf[key.strip()] = value.strip().strip('"')
    return conf


CONF = read_conf()
HA_URL = CONF.get("HA_URL", "http://homeassistant.local:8123").rstrip("/")
SCREEN_ID = CONF["SCREEN_ID"]
TOPIC = f"showroom_signage/{SCREEN_ID}"
MEDIA_DIR = Path(CONF.get("MEDIA_DIR", "/srv/showroom/signage"))
FILES_DIR = MEDIA_DIR / "media"
INDEX = MEDIA_DIR / "index.json"
M3U = MEDIA_DIR / "playlist.m3u"
SETTINGS = MEDIA_DIR / "settings.env"
SOCK = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "showroom-mpv.sock")


# ---------------------------------------------------------------- mpv


def mpv(*command, timeout=3):
    """Run one mpv IPC command; its data, or None if mpv isn't running."""
    try:
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(timeout)
            sock.connect(SOCK)
            sock.sendall((json.dumps({"command": list(command), "request_id": 7}) + "\n").encode())
            for line in sock.makefile():
                msg = json.loads(line)
                if msg.get("request_id") == 7:
                    return msg.get("data") if msg.get("error") == "success" else None
    except (OSError, ValueError):
        return None
    return None


class Watcher(threading.Thread):
    """Follows mpv (file, pause) and publishes the status."""

    def __init__(self, publish):
        super().__init__(daemon=True)
        self.publish = publish
        self.path = None
        self.paused = False
        self.position = 0.0  # seconds into the current file when last paused/started
        self.since = time.time()

    def settings(self):
        values = {}
        if SETTINGS.exists():
            for line in SETTINGS.read_text().splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    values[key] = value
        return values

    def status(self):
        if self.path is None:
            return {"state": "off"}
        position = self.position + (0 if self.paused else time.time() - self.since)
        duration = mpv("get_property", "duration")
        if not duration:  # pictures: mpv shows them for image-display-duration
            duration = float(self.settings().get("PICTURE_SECONDS", 0)) or None
        try:
            rel = str(Path(self.path).resolve().relative_to(FILES_DIR.resolve()))
        except ValueError:
            rel = Path(self.path).name
        return {
            "state": "paused" if self.paused else "playing",
            "file": rel,
            "duration": duration,
            "position": round(min(position, duration or position), 1),
        }

    def run(self):
        while True:
            try:
                self.follow()
            except (OSError, ValueError) as err:
                log.debug("mpv: %s", err)
            if self.path is not None:
                self.path = None
                self.publish(self.status())
            time.sleep(3)

    def follow(self):
        with socket.socket(socket.AF_UNIX) as sock:
            sock.connect(SOCK)
            for i, prop in enumerate(("path", "pause"), start=1):
                sock.sendall((json.dumps({"command": ["observe_property", i, prop]}) + "\n").encode())
            for line in sock.makefile():
                msg = json.loads(line)
                if msg.get("event") != "property-change":
                    continue
                now = time.time()
                if msg["name"] == "path" and msg.get("data") and msg["data"] != self.path:
                    self.path, self.position, self.since = msg["data"], 0.0, now
                elif msg["name"] == "pause" and bool(msg.get("data")) != self.paused:
                    if msg.get("data"):
                        self.position += now - self.since
                    else:
                        self.since = now
                    self.paused = bool(msg.get("data"))
                else:
                    continue
                if self.path:
                    self.publish(self.status())


# ---------------------------------------------------------------- playlist


def safe_target(rel):
    target = (FILES_DIR / rel).resolve()
    if FILES_DIR.resolve() not in target.parents:
        raise ValueError(f"bad file name {rel!r}")
    return target


def download(url, target):
    tmp = target.with_name(target.name + ".part")
    target.parent.mkdir(parents=True, exist_ok=True)
    with urllib.request.urlopen(HA_URL + url, timeout=60) as response, open(tmp, "wb") as out:
        while chunk := response.read(1 << 20):
            out.write(chunk)
    tmp.replace(target)


sync_lock = threading.Lock()


def sync(playlist):
    """Bring MEDIA_DIR in line with the playlist; reload mpv if it changed."""
    with sync_lock:
        FILES_DIR.mkdir(parents=True, exist_ok=True)
        index = json.loads(INDEX.read_text()) if INDEX.exists() else {}
        wanted = []
        for item in playlist.get("files", []):
            rel, version = item["name"], item["version"]
            target = safe_target(rel)
            if index.get(rel) != version or not target.exists():
                log.info("downloading %s", rel)
                try:
                    download(item["url"], target)
                except OSError as err:
                    log.warning("could not download %s: %s", rel, err)
                    continue
                index[rel] = version
                INDEX.write_text(json.dumps(index, indent=1))
            wanted.append(rel)
        # remove files that left the playlist
        for path in sorted(FILES_DIR.rglob("*"), reverse=True):
            rel = str(path.relative_to(FILES_DIR))
            if path.is_file() and rel not in wanted:
                log.info("removing %s", rel)
                path.unlink()
                index.pop(rel, None)
            elif path.is_dir() and not any(path.iterdir()):
                path.rmdir()
        INDEX.write_text(json.dumps(index, indent=1))

        seconds = int(playlist.get("picture_seconds") or 150)
        shuffle = "yes" if playlist.get("shuffle", True) else "no"
        m3u = "".join(f"{safe_target(rel)}\n" for rel in wanted)
        settings = f"PICTURE_SECONDS={seconds}\nSHUFFLE={shuffle}\nPLAYLIST={playlist.get('playlist') or ''}\n"
        key = hashlib.sha1((m3u + settings + json.dumps([index.get(r) for r in wanted])).encode()).hexdigest()
        old_key = (MEDIA_DIR / ".applied").read_text() if (MEDIA_DIR / ".applied").exists() else ""
        M3U.write_text(m3u)
        SETTINGS.write_text(settings)
        if key == old_key:
            return
        (MEDIA_DIR / ".applied").write_text(key)
        log.info("playlist %s: %d files, pictures %d s, shuffle %s", playlist.get("playlist"), len(wanted), seconds, shuffle)
        if wanted and mpv("get_property", "pid") is not None:
            mpv("set_property", "image-display-duration", seconds)
            mpv("loadlist", str(M3U), "replace")
            if shuffle == "yes":
                mpv("playlist-shuffle")
                mpv("playlist-play-index", 0)


# ---------------------------------------------------------------- MQTT


def main():
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    client = mqtt.Client(mqtt.CallbackAPIVersion.VERSION2, client_id=f"signage-{SCREEN_ID}")
    password = Path(CONF["MQTT_PASSWORD_FILE"]).read_text().strip() if CONF.get("MQTT_PASSWORD_FILE") else None
    if CONF.get("MQTT_USER"):
        client.username_pw_set(CONF["MQTT_USER"], password)
    client.will_set(f"{TOPIC}/availability", "offline", qos=1, retain=True)

    def publish(status):
        client.publish(f"{TOPIC}/status", json.dumps(status), qos=1, retain=True)

    watcher = Watcher(publish)

    def on_connect(client, userdata, flags, reason, properties):
        log.info("MQTT connected: %s", reason)
        client.subscribe([(f"{TOPIC}/playlist", 1), (f"{TOPIC}/command", 1)])
        client.publish(f"{TOPIC}/availability", "online", qos=1, retain=True)
        publish(watcher.status())

    def on_message(client, userdata, msg):
        if msg.topic.endswith("/playlist"):
            try:
                playlist = json.loads(msg.payload)
            except ValueError:
                log.warning("bad playlist message")
                return
            threading.Thread(target=sync, args=(playlist,), daemon=True).start()
        elif msg.topic.endswith("/command"):
            command = msg.payload.decode(errors="replace").strip()
            if command == "play":
                mpv("set_property", "pause", False)
            elif command == "pause":
                mpv("set_property", "pause", True)
            elif command == "next":
                mpv("playlist-next", "force")
            elif command == "previous":
                mpv("playlist-prev", "force")

    client.on_connect = on_connect
    client.on_message = on_message
    client.reconnect_delay_set(1, 60)
    watcher.start()
    client.connect_async(CONF.get("MQTT_HOST", "homeassistant.local"), int(CONF.get("MQTT_PORT", 1883)))
    client.loop_forever(retry_first_connection=True)


if __name__ == "__main__":
    main()
