# Signage agent (/usr/local/bin/showroom-signage-agent).
# SCREEN_ID must match the PC screen in Home Assistant (Signage > Configure).
SCREEN_ID=showroom_wall
HA_URL=http://homeassistant.local:8123
MQTT_HOST=homeassistant.local
MQTT_PORT=1883
MQTT_USER=showroom-pc
MQTT_PASSWORD_FILE=/home/display/.config/showroom/mqtt-password
MEDIA_DIR=/srv/showroom/signage
# MQTT topic prefix; Home Assistant 0.6+ (ha_signage) uses ha_signage.
# Set showroom_signage only if Home Assistant still runs 0.5 or older.
#TOPIC_PREFIX=ha_signage
